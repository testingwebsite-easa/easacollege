# ===================================================
# EASA College Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials
# ===================================================

# Server Configuration
PORT=5000
BASE_URL=http://localhost:5000

# MongoDB Database Connection
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/easa-college?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_jwt_secret_key_here
ADMIN_PASSWORD=your_initial_admin_password

# AWS S3 Cloud Storage (Resumes, Syllabus, Gallery Media)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=easa-college

# SMTP Email Configuration (Nodemailer for Admission Enquiries, ATS, Grievances)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=enquiry@ecetonline.com
SMTP_PASS=your_app_specific_password_here
SMTP_TO=enquiry@ecetonline.com

# YouTube API Integration (Optional for Campus Video Feed)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_HANDLE=EASACollegeOfficial
